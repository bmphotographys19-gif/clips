# ============ ClipRadar AI — copia este archivo a .env y rellénalo ============

# Dominio que apunta a tu servidor (registro DNS tipo A). Caddy obtiene el HTTPS solo.
DOMAIN=clipradar.tudominio.com
PUBLIC_URL=https://clipradar.tudominio.com

# Seguridad (genera valores largos y aleatorios: openssl rand -hex 32)
ADMIN_PASSWORD=
SECRET_KEY=
POSTGRES_PASSWORD=

# Infraestructura (no cambiar si usas docker-compose)
# Usa la MISMA contraseña que POSTGRES_PASSWORD:
DATABASE_URL=postgresql+psycopg://clipradar:CAMBIA_ESTA_CONTRASEÑA@postgres:5432/clipradar
REDIS_URL=redis://redis:6379/0

# ---- IA: Claude (console.anthropic.com → API Keys) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# ---- Transcripción local (faster-whisper). small = buen equilibrio en CPU ----
WHISPER_MODEL=small
WHISPER_LANGUAGE=es

# ---- TikTok (developers.tiktok.com → tu app → Login Kit + Content Posting API) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Vacío = ${PUBLIC_URL}/api/tiktok/callback (regístrala en TikTok).
# Si prefieres seguir usando la página de GitHub Pages ya aprobada, pon aquí su URL:
# TIKTOK_REDIRECT_URI=https://bmphotographys19-gif.github.io/clips/callback.html
TIKTOK_REDIRECT_URI=

# ---- YouTube (opcional) ----
YOUTUBE_API_KEY=
# Cookies de una cuenta de YouTube (formato Netscape) si YouTube bloquea al servidor:
YTDLP_COOKIES_FILE=

# ---- Almacenamiento de clips: local (volumen del servidor) o s3 (R2, B2, AWS…) ----
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Ajustes de captura y clips ----
SEGMENT_SECONDS=10
ANALYSIS_INTERVAL_SECONDS=60
ANALYSIS_WINDOW_SECONDS=240
BUFFER_RETENTION_MINUTES=40
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=90
RENDER_PRESET=veryfast
